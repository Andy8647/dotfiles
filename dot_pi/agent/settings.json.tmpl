{
  "theme": "catppuccin-mocha",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "xhigh",
  "shellPath": "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/fish{{ else if eq .chezmoi.os "linux" }}/usr/bin/fish{{ else }}/usr/bin/env fish{{ end }}",
  "packages": [
    "git:github.com/Andy8647/pi-powerline-footer",
    "git:github.com/Andy8647/pi-balance",
    "git:github.com/Andy8647/pi-toolbox",
    "npm:pi-mcp-adapter",
    "npm:pi-brain",
    "npm:pi-notify",
    "npm:@czottmann/pi-automode",
    "npm:@alexanderfortin/pi-tavily-tools",
    "npm:@getpipher/vision",
    "npm:pi-auto-router",
    "npm:@rohaquinlop/pi-deepseek-cache",
    "npm:remote-pi"
  ],
  "powerline": {
    "preset": "default",
    "separator": "powerline",
    "segmentStyle": "pill",
    "layout": {
      "left": ["model", "thinking", "path", "git"],
      "right": ["custom:balance", "custom:automode", "custom:mcp", "custom:tavily", "cache_read", "context_pct"],
      "secondary": []
    },
    "segmentOptions": {
      "path": { "mode": "basename" }
    },
    "customItems": [
      { "id": "automode", "statusKey": "pi-automode", "position": "right", "color": "#cba6f7", "hideWhenMissing": false },
      { "id": "mcp", "statusKey": "mcp-status", "position": "right", "color": "#89b4fa", "hideWhenMissing": true },
      { "id": "tavily", "statusKey": "tavily-usage", "position": "right", "color": "#a6e3a1", "hideWhenMissing": true },
      { "id": "balance", "statusKey": "provider-balance", "position": "right", "color": "#f9e2af", "excludeFromExtensionStatuses": true, "hideWhenMissing": true }
    ],
    "disabledSegments": ["extension_statuses"]
  },
  "showLastPrompt": false,
  "hideThinkingBlock": true,
  "toolbox": {
    "highlightBash": true,
    "enabled": true
  }
}

{
  "theme": "catppuccin-mocha",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "deepseek/*"
  ],
  "shellPath": "/opt/homebrew/bin/fish",
  "subagents": {
    "artifactDir": "session"
  },
  "packages": [
    "npm:pi-starline",
    "git:github.com/Andy8647/pi-balance",
    "git:github.com/Andy8647/pi-agent-loop",
    "npm:pi-mcp-adapter",
    "npm:pi-brain",
    "npm:pi-notify",
    "npm:@czottmann/pi-automode",
    "npm:@alexanderfortin/pi-tavily-tools",
    "npm:@rohaquinlop/pi-deepseek-cache",
    "npm:pi-subagents",
    "npm:@andy8647/pi-toolbox"
  ],
  "powerline": {
    "preset": "default",
    "separator": "powerline",
    "segmentStyle": "pill",
    "copyOnSelect": false,
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git"
      ],
      "right": [
        "custom:balance",
        "custom:automode",
        "custom:mcp",
        "custom:tavily",
        "cache_read",
        "context_pct"
      ],
      "secondary": []
    },
    "segmentOptions": {
      "path": {
        "mode": "basename"
      }
    },
    "customItems": [
      {
        "id": "automode",
        "statusKey": "pi-automode",
        "position": "right",
        "color": "#cba6f7",
        "hideWhenMissing": false
      },
      {
        "id": "mcp",
        "statusKey": "mcp-status",
        "position": "right",
        "color": "#89b4fa",
        "hideWhenMissing": true
      },
      {
        "id": "tavily",
        "statusKey": "tavily-usage",
        "position": "right",
        "color": "#a6e3a1",
        "hideWhenMissing": true
      },
      {
        "id": "balance",
        "statusKey": "provider-balance",
        "position": "right",
        "color": "#f9e2af",
        "excludeFromExtensionStatuses": true,
        "hideWhenMissing": true
      }
    ],
    "disabledSegments": [
      "extension_statuses"
    ],
    "context": {
      "format": "percent"
    },
    "cache_read": {
      "format": "percent"
    },
    "editorCursor": "terminal",
    "pasteCollapseLines": 3,
    "fixedEditor": true
  },
  "showLastPrompt": false,
  "hideThinkingBlock": true,
  "toolbox": {
    "highlightBash": true,
    "enabled": true
  },
  "lastChangelogVersion": "0.83.0",
  "terminal": {
    "showTerminalProgress": false
  },
  "showHardwareCursor": true
}